<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standard/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standard/kcfg/1.0
      http://www.kde.org/standard/kcfg/1.0/kcfg.xsd">
    <kcfgfile name=""/>
    <group name="General">
        <entry name="fieldWidth" type="Int">
            <label>Width of the search box, in grid units.</label>
            <default>14</default>
        </entry>
        <entry name="terminalCommand" type="String">
            <label>Terminal used for commands; the command line is appended after -e.</label>
            <default>konsole</default>
        </entry>
    </group>
</kcfg>
